# Object bytes must only ever be reached through public/index.php's auth
# checks (SigV4 / public-bucket rules) - never served directly by the web
# server. index.php reads these files straight off disk (fopen/readfile, or
# X-Sendfile, which Apache resolves from the filesystem, not over HTTP), so
# blocking direct web access here doesn't break anything it needs.
Options -Indexes -ExecCGI

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phps .phar

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
